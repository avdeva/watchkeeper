      "id": "6e3c974d",
      "name": "Move ISO  T: > D:",
      "enabled": false,
      "path": "T:\\ISO",
      "destination": "D:\\ISO",
      "schedule": {
        "mode": "interval",
        "time": "00:00",
        "interval_minutes": 1,
        "day": "sunday",
        "catch_up": true
      },
      "subfolders": false,
      "min_age_seconds": 60,
      "remove_empty_folders": false,
      "rules": [
        {
          "id": "1062db8e",
          "name": "Move every file",
          "enabled": true,
          "action": "move",
          "destination": "",
          "keep_subfolders": true,
          "on_conflict": "rename",
          "pattern": "*",
          "exclude": "",
          "older_than": 0,
          "older_than_unit": "days",
          "min_size_mb": 0,
          "max_size_mb": 0,
          "use_window": false,
          "window_start": "00:00",
          "window_end": "23:59",
          "window_mode": "inside",
          "window_source": "modified",
          "keep_newest": 0,
          "stamp_from_name": false
        }
      ],
      "notes": "Cache to data drive, every minute. Files still being recorded are left until they are finished."
