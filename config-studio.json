      "rules": [
        {
          "id": "669a74f1",
          "name": "Started 05:45-09:00: move to ISO",
          "enabled": true,
          "action": "move",
          "destination": "",
          "keep_subfolders": true,
          "on_conflict": "overwrite",
          "pattern": "*.mp4;*.avi;*.mkv;*.mov",
          "exclude": "",
          "older_than": 0,
          "older_than_unit": "days",
          "min_size_mb": 0,
          "max_size_mb": 0,
          "use_window": true,
          "window_start": "05:45",
          "window_end": "09:00",
          "window_mode": "inside",
          "window_source": "filename",
          "keep_newest": 0,
          "stamp_from_name": true
        },
        {
          "id": "d5d2379e",
          "name": "Started outside the window: delete",
          "enabled": true,
          "action": "delete",
          "destination": "",
          "keep_subfolders": true,
          "on_conflict": "overwrite",
          "pattern": "*.mp4;*.avi;*.mkv;*.mov",
          "exclude": "",
          "older_than": 0,
          "older_than_unit": "days",
          "min_size_mb": 0,
          "max_size_mb": 0,
          "use_window": true,
          "window_start": "05:45",
          "window_end": "09:00",
          "window_mode": "outside",
          "window_source": "filename",
          "keep_newest": 0,
          "stamp_from_name": false
        },
        {
          "id": "af936e13",
          "name": "Anything else: move to D:\\Producer_Cam",
          "enabled": true,
          "action": "move",
          "destination": "D:\\Producer_Cam",
          "keep_subfolders": true,
          "on_conflict": "rename",
          "pattern": "*",
          "exclude": "",
          "older_than": 0,
          "older_than_unit": "days",
          "min_size_mb": 0,
          "max_size_mb": 0,
          "use_window": false,
          "window_start": "00:00",
          "window_end": "23:59",
          "window_mode": "inside",
          "window_source": "modified",
          "keep_newest": 0,
          "stamp_from_name": false
        }
      ],
      "notes": "Every minute. Recordings started 05:45-09:00 move to D:\\ISO, other recordings are deleted, anything else moves to D:\\Producer_Cam, so the cache folder is emptied."
