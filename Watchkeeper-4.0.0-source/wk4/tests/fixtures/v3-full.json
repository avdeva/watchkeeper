      "rules": [
        {
          "id": "3f820415",
          "name": "Started 05:45-09:00: move to ISO",
          "enabled": true,
          "action": "move",
          "destination": "",
          "keep_subfolders": true,
          "on_conflict": "overwrite",
          "pattern": "*.mp4;*.avi;*.mkv;*.mov",
          "exclude": "",
          "older_than": 0,
          "older_than_unit": "days",
          "min_size_mb": 0,
          "max_size_mb": 0,
          "use_window": true,
          "window_start": "05:45",
          "window_end": "09:00",
