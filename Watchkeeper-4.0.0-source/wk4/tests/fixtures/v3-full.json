    {
      "id": "13be6896",
      "name": "Move ISO  T: > D:",
      "enabled": true,
      "path": "T:\\ISO",
      "destination": "D:\\ISO",
      "schedule": {
        "mode": "interval",
        "time": "00:00",
        "interval_minutes": 1,
        "day": "sunday",
        "catch_up": true
      },
      "subfolders": false,
      "min_age_seconds": 60,
      "remove_empty_folders": false,
      "rules": [
        {
          "id": "6efed5f3",
          "name": "Move every file",
          "enabled": true,
          "action": "move",
          "destination": "",
          "keep_subfolders": true,
          "on_conflict": "rename",
          "pattern": "*",
          "exclude": "",
          "older_than": 0,
          "older_than_unit": "days",
          "min_size_mb": 0,
          "max_size_mb": 0,
          "use_window": false,
          "window_start": "00:00",
          "window_end": "23:59",
          "window_mode": "inside",
          "window_source": "modified",
          "keep_newest": 0,
          "stamp_from_name": false
        },
        {
          "id": "k1",
          "name": "Keep tmp",
          "enabled": true,
          "action": "keep",
          "pattern": "*.tmp"
        },
        {
          "id": "d1",
          "name": "Old",
          "enabled": true,
          "action": "delete",
          "pattern": "*.mp4",
          "older_than": 2,
          "older_than_unit": "weeks",
          "use_window": true
        }
      ],
      "notes": "Cache to data drive, every minute. Files still being recorded are left until they are finished."
