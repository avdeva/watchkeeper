  "folders": [
    {
      "id": "move",
      "name": "Move recordings to storage",
      "enabled": false,
      "source": "T:\\Recordings",
      "subfolders": true,
      "include": "*.mp4;*.mov",
      "exclude": "",
      "action": "move",
      "destination": "D:\\Recordings",
      "keep_structure": true,
      "if_exists": "rename",
      "older_than": 0,
      "older_than_unit": "days",
      "keep_newest": 0,
      "settle_seconds": 60,
      "remove_empty_folders": true,
      "run": "every",
      "interval_minutes": 1,
      "at": "03:00",
      "notes": "Example: from the recording drive to the storage drive every minute; recordings still being written are left alone."
    },
    {
      "id": "retention",
      "name": "Delete recordings older than 30 days",
      "enabled": false,
      "source": "D:\\Recordings",
      "subfolders": true,
      "include": "*.mp4;*.mov",
      "exclude": "",
      "action": "delete",
      "destination": "",
      "keep_structure": true,
      "if_exists": "rename",
      "older_than": 30,
      "older_than_unit": "days",
      "keep_newest": 0,
      "settle_seconds": 60,
      "remove_empty_folders": true,
      "run": "daily",
      "interval_minutes": 5,
      "at": "03:00",
      "notes": "Example retention."
    }
  ],
  "vertical": {
    "enabled": false,
    "watch_folder": "T:\\Vertical",
    "output_folder": "D:\\Vertical",
    "extensions": [
      ".mp4"
    ],
    "settle_seconds": 10,
    "sources": [
      {
        "name": "Program",
        "match": "Program",
        "prefix": "Vertical Program",
        "enabled": true
      }
    ],
    "convert_others": true,
    "other_prefix": "Vertical",
    "after_success": "move",
    "move_originals_to": "D:\\Vertical\\Originals",
    "retries": 3,
    "codec": "h264",
    "rotate": "counterclockwise",
    "width": 0,
    "height": 0,
    "fps": 0,
    "bitrate": "source",
    "fixed_mbps": 8,
    "quality": 23,
    "fallback_mbps": 8,
    "preset": "balanced",
    "audio": "copy",
    "audio_kbps": 192,
    "extra_input_args": "",
    "extra_output_args": "",
    "encoder": "auto",
    "gpu_index": -1,
    "hardware_decode": true,
    "user_session_fallback": true,
    "cpu_fallback": true,
    "priority": "below_normal"
